# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.env
*.tmp

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.gradle/
local.properties
key.properties
*.jks
*.keystore
*.key

# Backup files
*.bak
*.orig

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
ios/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# CocoaPods: the lockfile is tracked, so a release built from a clean tree
# uses the pinned pod versions (even where a global gitignore leaves it out).
!ios/Podfile.lock

# Node.js dependencies
node_modules/
vendor/bundle/
.bundle/

# Local app configuration
config/env/*.local.json
fastlane/.env
fastlane/.env.*
!fastlane/.env.example
fastlane/README.md
fastlane/report.xml
fastlane/secrets/
