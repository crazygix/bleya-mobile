# Copy this file to fastlane/.env and fill in local-only secret paths/IDs.
# Do not commit fastlane/.env or files under fastlane/secrets/.

APP_IDENTIFIER=com.bleyachat
ANDROID_PACKAGE_NAME=com.bleyachat
APPLE_TEAM_ID=S7V679NZ3B

# App Store Connect API key, created in App Store Connect -> Users and Access
# -> Integrations -> App Store Connect API.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILEPATH=fastlane/secrets/AuthKey_XXXXXXXXXX.p8

# Alternative: use a fastlane API key JSON file instead of the three values above.
# APP_STORE_CONNECT_API_KEY_PATH=fastlane/secrets/app-store-connect-api-key.json

# Google Play Console service account JSON with release permissions.
GOOGLE_PLAY_JSON_KEY=fastlane/secrets/google-play-service-account.json

# Optional overrides.
PROD_DART_DEFINES=config/env/prod.local.json
FLUTTER_BIN=flutter
DART_BIN=$HOME/flutter/bin/dart
PLAY_INTERNAL_TRACK=internal
PLAY_INTERNAL_RELEASE_STATUS=completed
PLAY_PRODUCTION_RELEASE_STATUS=draft

# Optional release version overrides. If RELEASE_BUILD_NUMBER is omitted,
# fastlane generates a UTC timestamp-based value.
# RELEASE_BUILD_NAME=0.1.0
# RELEASE_BUILD_NUMBER=2

# Set to 1 to skip pub get, analyze, and tests during release lanes.
SKIP_CHECKS=0
