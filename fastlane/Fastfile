begin
  require "spaceship"
  require "dotenv"
  Dotenv.load(File.expand_path(".env", __dir__))
rescue LoadError
  # fastlane bundles dotenv. If it is unavailable, environment variables still work.
end

require "time"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("..", __dir__)
APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.bleyachat")
ANDROID_PACKAGE_NAME = ENV.fetch("ANDROID_PACKAGE_NAME", "com.bleyachat")
PROD_DART_DEFINES = ENV.fetch("PROD_DART_DEFINES", "config/env/prod.local.json")
FLUTTER_BIN = ENV.fetch("FLUTTER_BIN", "flutter")
DART_BIN = ENV.fetch("DART_BIN", "$HOME/flutter/bin/dart")
PLAY_INTERNAL_TRACK = ENV.fetch("PLAY_INTERNAL_TRACK", "internal")

def require_env!(name)
  value = ENV[name].to_s.strip
  if value.empty?
    if name == "APP_STORE_CONNECT_ISSUER_ID"
      UI.user_error!(
        "Missing APP_STORE_CONNECT_ISSUER_ID. Add it to fastlane/.env from App Store Connect > Users and Access > Integrations > App Store Connect API > Issuer ID."
      )
    end

    UI.user_error!("Missing required environment variable: #{name}")
  end

  value
end

def project_path(path)
  return path if path.start_with?("/")

  File.join(PROJECT_ROOT, path)
end

def require_file!(path, description)
  resolved_path = project_path(path)
  UI.user_error!("Missing #{description}: #{path}") unless File.exist?(resolved_path)
  resolved_path
end

def pubspec_version
  pubspec = File.read(project_path("pubspec.yaml"))
  match = pubspec.match(/^version:\s*([0-9]+\.[0-9]+\.[0-9]+)\+([0-9]+)\s*$/)
  UI.user_error!("Could not resolve release version from pubspec.yaml. Expected version: x.y.z+n") unless match

  {
    build_name: match[1],
    build_number: match[2].to_i
  }
end

def write_pubspec_version!(build_name, build_number)
  pubspec_path = project_path("pubspec.yaml")
  pubspec = File.read(pubspec_path)
  updated = pubspec.sub(/^version:\s*[0-9]+\.[0-9]+\.[0-9]+\+[0-9]+\s*$/, "version: #{build_name}+#{build_number}")

  UI.user_error!("Could not update version in pubspec.yaml") if updated == pubspec

  File.write(pubspec_path, updated)
  UI.message("Bumped pubspec.yaml version to #{build_name}+#{build_number}.")
end

def release_build_name(options)
  return options[:build_name].to_s if options[:build_name]
  return ENV["RELEASE_BUILD_NAME"].to_s.strip unless ENV["RELEASE_BUILD_NAME"].to_s.strip.empty?

  pubspec_version[:build_name]
end

def release_build_number(options)
  return options[:build_number].to_s if options[:build_number]
  return ENV["RELEASE_BUILD_NUMBER"].to_s.strip unless ENV["RELEASE_BUILD_NUMBER"].to_s.strip.empty?

  pubspec_version[:build_number].to_s
end

def next_release_build_number(options)
  return release_build_number(options) if options[:build_number]
  return release_build_number(options) unless ENV["RELEASE_BUILD_NUMBER"].to_s.strip.empty?

  (pubspec_version[:build_number] + 1).to_s
end

# Moves pubspec.yaml up to the build just uploaded, so the next release starts
# from the number after it. It never moves pubspec.yaml back: an override below
# the current number leaves it as it is, and one above it carries on from there.
# The lane never commits; it prints the command instead.
def persist_release_build_number!(build_name, build_number)
  current = pubspec_version[:build_number]
  if build_number.to_i <= current
    UI.message("pubspec.yaml is already at build #{current}, so it stays as it is.")
    return
  end

  write_pubspec_version!(build_name, build_number)
  UI.important("Commit the version bump before the next release build:")
  UI.important("  git commit -m \"chore: Build #{build_name}+#{build_number}\" pubspec.yaml")
end

def run_quality_checks
  return if ENV["SKIP_CHECKS"].to_s == "1"

  Dir.chdir(PROJECT_ROOT) do
    sh("#{FLUTTER_BIN} pub get")
    sh("#{DART_BIN} analyze")
    sh("#{FLUTTER_BIN} test")
  end
end

def git_output(*args)
  Actions.sh("git", *args, log: false).strip
end

# Every release build comes from a commit, so each build number can be traced
# back to its code. Untracked files count too.
def ensure_release_tree_clean!
  ensure_git_status_clean(show_uncommitted_changes: true)
rescue FastlaneCore::Interface::FastlaneError => error
  UI.user_error!("Release builds are made only from committed code. Commit your changes first; after a release, that includes the pubspec.yaml version bump the lane printed. #{error.message}")
end

# The checks every build lane starts with: a clean tree (also with SKIP_CHECKS),
# then, after any quicker checks passed as a block, analyze and the tests.
# Remembers the commit being built, for the build/N tag.
def release_preflight!
  ensure_release_tree_clean!
  @release_commit = git_output("rev-parse", "HEAD")
  yield if block_given?
  run_quality_checks
end

# When the commit being built was made.
def release_commit_time
  Time.at(git_output("log", "-1", "--format=%ct", @release_commit || "HEAD").to_i)
end

# Tags the commit a build came from as build/N. The tag stays local; the lane
# never pushes.
def tag_release_build!(build_name, build_number)
  tag = "build/#{build_number}"
  if git_tag_exists(tag: tag)
    tagged_commit = git_output("rev-list", "-n", "1", tag)
    if tagged_commit == @release_commit
      UI.message("Tag #{tag} is already on this commit.")
    else
      UI.important("Tag #{tag} already exists on #{tagged_commit[0, 7]}, not on this build's commit #{@release_commit.to_s[0, 7]}. It stays where it is.")
    end
    return
  end

  add_git_tag(tag: tag, message: "Bleya #{build_name} (#{build_number})", commit: @release_commit)
  UI.message("Tagged #{tag} on the commit it was built from. The tag is local; to share it: git push origin #{tag}")
end

def ensure_prod_config!
  UI.user_error!("Missing #{PROD_DART_DEFINES}. Create it from config/env/prod.example.json.") unless File.exist?(project_path(PROD_DART_DEFINES))
end

def ensure_android_signing!
  UI.user_error!("Missing android/key.properties for release signing.") unless File.exist?(project_path("android/key.properties"))
end

def app_store_connect_options
  api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
  return { api_key_path: require_file!(api_key_path, "App Store Connect API key JSON") } unless api_key_path.empty?

  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip

  {
    api_key: app_store_connect_api_key(
      key_id: require_env!("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: issuer_id.empty? ? nil : issuer_id,
      key_filepath: require_file!(require_env!("APP_STORE_CONNECT_KEY_FILEPATH"), "App Store Connect API key file"),
      duration: 1200,
      in_house: false
    )
  }
end

def google_play_json_key
  require_file!(require_env!("GOOGLE_PLAY_JSON_KEY"), "Google Play service account JSON")
end

# The version codes on a Play track's current releases.
def play_version_codes(track)
  google_play_track_version_codes(
    package_name: ANDROID_PACKAGE_NAME,
    json_key: google_play_json_key,
    track: track
  )
end

# Runs before a long build: fails when Play access is broken, or when Play would
# refuse the number because the internal track already has it or a higher one.
def ensure_play_accepts!(build_name, build_number)
  highest = play_version_codes(PLAY_INTERNAL_TRACK).max
  if highest && build_number.to_i <= highest
    UI.user_error!("Play's #{PLAY_INTERNAL_TRACK} track already has version code #{highest}, so it won't accept #{build_number}. Set `version: #{build_name}+#{highest}` in pubspec.yaml, commit it and run the lane again.")
  end

  UI.message("Play accepts version code #{build_number} (newest on the #{PLAY_INTERNAL_TRACK} track: #{highest || 'none'}).")
end

def app_store_connect_app
  @app_store_connect_app ||= begin
    options = app_store_connect_options
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**options[:api_key]) if options[:api_key]

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App Store Connect app not found for bundle ID #{APP_IDENTIFIER}.") unless app
    app
  end
end

def testflight_group_names
  configured_groups = ENV["TESTFLIGHT_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
  beta_groups = app_store_connect_app.get_beta_groups

  selected_groups = if configured_groups.empty?
    beta_groups.select(&:is_internal_group)
  else
    beta_groups.select { |group| configured_groups.include?(group.name) }
  end

  if configured_groups.any?
    missing_groups = configured_groups - selected_groups.map(&:name)
    UI.user_error!("Missing TestFlight beta groups: #{missing_groups.join(', ')}") unless missing_groups.empty?
  end

  auto_access_groups = selected_groups.select(&:has_access_to_all_builds)
  assignable_groups = selected_groups.reject(&:has_access_to_all_builds)

  unless auto_access_groups.empty?
    UI.message("Skipping explicit TestFlight assignment for groups that already have access to all builds: #{auto_access_groups.map(&:name).join(', ')}")
  end

  group_names = assignable_groups.map(&:name)
  if selected_groups.empty?
    UI.important("No internal TestFlight groups found. Build will upload but will not be auto-assigned to testers.")
  elsif group_names.empty?
    UI.message("No explicit TestFlight group assignment is needed for the selected internal groups.")
  end

  UI.message("Using TestFlight groups: #{group_names.join(', ')}") unless group_names.empty?
  group_names
end

def existing_testflight_build(build_name:, build_number:)
  builds = app_store_connect_app.get_builds(
    includes: Spaceship::ConnectAPI::Build::ESSENTIAL_INCLUDES,
    filter: {
      "preReleaseVersion.version" => build_name,
      version: build_number,
      processingState: "PROCESSING,VALID"
    },
    sort: "-uploadedDate",
    limit: 10
  )

  builds.find { |build| build.platform.to_s.casecmp("ios").zero? }
end

# A build already on TestFlight can stand in for this run only when nothing was
# committed after its upload. Otherwise iOS and Android would ship different
# code under one build number.
def ensure_ios_build_reusable!(build, build_name:, build_number:)
  uploaded_at = begin
    build.uploaded_date.to_s.empty? ? nil : Time.parse(build.uploaded_date.to_s)
  rescue ArgumentError
    nil
  end
  return if uploaded_at && release_commit_time <= uploaded_at

  reason = uploaded_at ? "it was uploaded before your latest commit" : "App Store Connect doesn't say when it was uploaded"
  UI.user_error!("Build #{build_name} (#{build_number}) is already on TestFlight, but #{reason}, so its code may be different. Set `version: #{build_name}+#{build_number}` in pubspec.yaml, commit it and run the lane again: both platforms then get build #{build_number.to_i + 1}.")
end

def testflight_upload_options(groups:)
  {
    app_identifier: APP_IDENTIFIER,
    app_platform: "ios",
    groups: groups.empty? ? nil : groups,
    distribute_external: false,
    notify_external_testers: false,
    submit_beta_review: false,
    uses_non_exempt_encryption: false,
    **app_store_connect_options
  }
end

def upload_android_release!(aab_path:, track:, release_status:)
  upload_to_play_store(
    package_name: ANDROID_PACKAGE_NAME,
    json_key: google_play_json_key,
    aab: aab_path,
    track: track,
    release_status: release_status,
    skip_upload_metadata: true,
    skip_upload_changelogs: true,
    skip_upload_images: true,
    skip_upload_screenshots: true
  )
end

def upload_android_internal_release!(aab_path:)
  track = PLAY_INTERNAL_TRACK
  release_status = ENV.fetch("PLAY_INTERNAL_RELEASE_STATUS", "completed")

  upload_android_release!(aab_path: aab_path, track: track, release_status: release_status)
rescue => error
  if release_status != "draft" && error.message.include?("Only releases with status draft may be created on draft app")
    UI.important("Play Console app is still in draft state. Retrying internal upload with release_status=draft.")
    upload_android_release!(aab_path: aab_path, track: track, release_status: "draft")
  else
    raise
  end
end

def validate_app_store_connect!
  app_store_connect_app
  UI.message("Validated App Store Connect access for #{APP_IDENTIFIER}.")
rescue => error
  message = error.message.to_s
  if message.match?(/agreement|terms/i)
    UI.user_error!(
      "App Store Connect rejected the request for #{APP_IDENTIFIER}: an Apple agreement is missing or has expired — this is NOT a key/credential problem. Sign in to App Store Connect as the Account Holder and accept the pending agreement under Business (Agreements, Tax, and Banking), and/or use the 'Review Agreement' banner at https://developer.apple.com/account. Acceptance is eventually-consistent, so wait a few minutes before re-running. Original error: #{message}"
    )
  else
    UI.user_error!(
      "App Store Connect authentication failed for #{APP_IDENTIFIER}. Use an App Store Connect API key from App Store Connect > Users and Access > Integrations > App Store Connect API. An Apple Developer APNs .p8 key will not work here. Original error: #{message}"
    )
  end
end

def newest_file(pattern)
  file = Dir[project_path(pattern)].max_by { |path| File.mtime(path) }
  UI.user_error!("No file matched #{pattern}") unless file
  file
end

def flutter_build_ipa(build_name, build_number)
  Dir.chdir(PROJECT_ROOT) do
    sh([
      FLUTTER_BIN,
      "build ipa",
      "--flavor prod",
      "--release",
      "--dart-define-from-file=#{PROD_DART_DEFINES}",
      "--build-name #{build_name}",
      "--build-number #{build_number}",
      "--export-method app-store"
    ].join(" "))
  end

  newest_file("build/ios/ipa/*.ipa")
end

def flutter_build_aab(build_name, build_number)
  Dir.chdir(PROJECT_ROOT) do
    sh([
      FLUTTER_BIN,
      "build appbundle",
      "--flavor prod",
      "--release",
      "--dart-define-from-file=#{PROD_DART_DEFINES}",
      "--build-name #{build_name}",
      "--build-number #{build_number}"
    ].join(" "))
  end

  newest_file("build/app/outputs/bundle/prodRelease/*.aab")
end

# Builds and uploads iOS, or hands the build already on TestFlight to testers
# when an earlier run uploaded this number from the same commit.
def upload_ios_build!(build_name:, build_number:, groups:)
  existing_build = existing_testflight_build(build_name: build_name, build_number: build_number)

  if existing_build
    ensure_ios_build_reusable!(existing_build, build_name: build_name, build_number: build_number)
    UI.important("Build #{build_name} (#{build_number}) already exists in App Store Connect with state #{existing_build.processing_state}. Reusing it for TestFlight distribution.")
    upload_to_testflight(
      distribute_only: true,
      app_version: build_name,
      build_number: build_number,
      **testflight_upload_options(groups: groups)
    )
  else
    ipa_path = flutter_build_ipa(build_name, build_number)

    upload_to_testflight(
      ipa: ipa_path,
      **testflight_upload_options(groups: groups)
    )
  end
end

def upload_android_internal_build!(build_name:, build_number:)
  aab_path = flutter_build_aab(build_name, build_number)
  upload_android_internal_release!(aab_path: aab_path)
end

desc "Build prod iOS and upload it to TestFlight"
lane :ios_testflight do |options|
  # First, so App Store Connect problems (such as an agreement to accept) show
  # with their hint before anything else runs.
  validate_app_store_connect!
  ensure_prod_config!
  release_preflight!

  build_name = release_build_name(options)
  build_number = next_release_build_number(options)
  groups = testflight_group_names

  upload_ios_build!(build_name: build_name, build_number: build_number, groups: groups)

  persist_release_build_number!(build_name, build_number)
  tag_release_build!(build_name, build_number)
end

desc "Build prod Android and upload it to Play Console internal testing"
lane :android_internal do |options|
  ensure_prod_config!
  ensure_android_signing!

  build_name = release_build_name(options)
  build_number = next_release_build_number(options)
  release_preflight! { ensure_play_accepts!(build_name, build_number) }

  upload_android_internal_build!(build_name: build_name, build_number: build_number)

  persist_release_build_number!(build_name, build_number)
  tag_release_build!(build_name, build_number)
end

desc "Promote a tested Play internal-testing build to a draft production release (version_code:N)"
lane :android_promote_production do |options|
  version_code = (options[:version_code] || ENV["PLAY_PROMOTE_VERSION_CODE"]).to_s.strip
  internal_codes = play_version_codes(PLAY_INTERNAL_TRACK)
  listed = internal_codes.empty? ? "none" : internal_codes.sort.reverse.join(", ")

  if version_code.empty?
    UI.user_error!("Pass the version code that passed the device checks, e.g. bundle exec fastlane android_promote_production version_code:#{internal_codes.max || 'N'}. On the #{PLAY_INTERNAL_TRACK} track now: #{listed}.")
  end
  unless version_code.match?(/\A[0-9]+\z/) && internal_codes.include?(version_code.to_i)
    UI.user_error!("Version code #{version_code} is not on the #{PLAY_INTERNAL_TRACK} track (it has: #{listed}). Only the build in internal testing can be promoted to production.")
  end

  validate_only = options[:validate_only] == true
  release_status = ENV.fetch("PLAY_PRODUCTION_RELEASE_STATUS", "draft")

  # Promotes the exact bundle testers had. Nothing is built or uploaded.
  upload_to_play_store(
    package_name: ANDROID_PACKAGE_NAME,
    json_key: google_play_json_key,
    track: PLAY_INTERNAL_TRACK,
    track_promote_to: "production",
    version_code: version_code.to_i,
    track_promote_release_status: release_status,
    validate_only: validate_only,
    skip_upload_apk: true,
    skip_upload_aab: true,
    skip_upload_metadata: true,
    skip_upload_changelogs: true,
    skip_upload_images: true,
    skip_upload_screenshots: true
  )

  if validate_only
    UI.success("Play accepts promoting version code #{version_code} to production. Nothing was changed.")
  else
    UI.success("Version code #{version_code} is now a #{release_status} production release. Review it and roll it out in Play Console.")
  end
end

desc "Run checks, build prod iOS/Android, upload to TestFlight and Play internal testing"
lane :testing do |options|
  ensure_prod_config!
  ensure_android_signing!
  validate_app_store_connect!

  build_name = release_build_name(options)
  build_number = next_release_build_number(options)
  # The tree is checked once, here: the iOS build can rewrite tracked files
  # (such as ios/Podfile.lock) before the Android half runs.
  release_preflight! { ensure_play_accepts!(build_name, build_number) }
  groups = testflight_group_names

  UI.message("Preparing Bleya #{build_name} (#{build_number}) for testing.")

  upload_ios_build!(build_name: build_name, build_number: build_number, groups: groups)
  upload_android_internal_build!(build_name: build_name, build_number: build_number)

  # Only after both uploads, so a rerun after a failure above uses the same
  # number.
  persist_release_build_number!(build_name, build_number)
  tag_release_build!(build_name, build_number)
end

desc "Build prod iOS IPA and Android AAB without uploading"
lane :build_prod do |options|
  build_name = release_build_name(options)
  build_number = release_build_number(options)

  UI.message("Building Bleya #{build_name} (#{build_number}) without uploading.")
  ensure_prod_config!
  ensure_android_signing!
  release_preflight!

  ipa_path = flutter_build_ipa(build_name, build_number)
  aab_path = flutter_build_aab(build_name, build_number)

  UI.success("Built IPA: #{ipa_path}")
  UI.success("Built AAB: #{aab_path}")
end
