{
  "folders": [
    {
      "name": "Backend (Node.js)",
      "path": "../backend"
    },
    {
      "name": "Mobile (Flutter)",
      "path": "."
    }
  ],
  "settings": {
    "typescript.preferences.includePackageJsonAutoImports": "auto",
    "dart.flutterSdkPath": "/Users/ivan.kokanovic/flutter",
    "dart.flutterSdkPaths": [
      "/Users/ivan.kokanovic/flutter"
    ],
    "dart.projectSearchDepth": 6,
    "git.detectSubmodules": false,
    "git.autoRepositoryDetection": "subFolders",
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.dart_tool": true,
      "**/build": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.dart_tool": true,
      "**/build": true,
      "**/ios/Pods": true,
      "**/android/.gradle": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Mobile dev",
        "type": "dart",
        "request": "launch",
        "program": "${workspaceFolder:Mobile (Flutter)}/lib/main.dart",
        "cwd": "${workspaceFolder:Mobile (Flutter)}",
        "args": [
          "--dart-define-from-file=${workspaceFolder:Mobile (Flutter)}/config/env/dev.local.json"
        ]
      },
      {
        "name": "Mobile prod",
        "type": "dart",
        "request": "launch",
        "program": "${workspaceFolder:Mobile (Flutter)}/lib/main.dart",
        "cwd": "${workspaceFolder:Mobile (Flutter)}",
        "args": [
          "--dart-define-from-file=${workspaceFolder:Mobile (Flutter)}/config/env/prod.example.json"
        ]
      },
      {
        "name": "Mobile release",
        "type": "dart",
        "request": "launch",
        "program": "${workspaceFolder:Mobile (Flutter)}/lib/main.dart",
        "cwd": "${workspaceFolder:Mobile (Flutter)}",
        "args": [
          "--dart-define-from-file=${workspaceFolder:Mobile (Flutter)}/config/env/prod.example.json"
        ],
        "flutterMode": "release"
      },
      {
        "name": "Launch server",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run build && npm start",
        "cwd": "${workspaceFolder:Backend (Node.js)}"
      },
      {
        "name": "Test backend",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm test",
        "cwd": "${workspaceFolder:Backend (Node.js)}"
      },
      {
        "name": "Test mobile",
        "type": "node-terminal",
        "request": "launch",
        "command": "flutter test",
        "cwd": "${workspaceFolder:Mobile (Flutter)}"
      }
    ]
  }
}
